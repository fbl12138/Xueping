{
  "Jwt": {
    "Issuer": "XuePing",
    "Audience": "XuePing",
    "Key": "dev-only-key-change-me-in-production-0123456789",
    "ExpireMinutes": 120
  },

  "ConnectionStrings": {
    "Default": "Server=localhost;Database=XuePingDB;Trusted_Connection=True;TrustServerCertificate=True;",
    "Redis": "localhost:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MessageBus": {
    "Provider": "RedisStream",
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "VirtualHost": "/"
  },
  "AllowedHosts": "*"
}
