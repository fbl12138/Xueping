{
  "Jwt": {
    "Issuer": "XuePing",
    "Audience": "XuePing",
    "Key": "<至少 32 位的随机字符串，生产环境请用环境变量 Jwt__Key 覆盖>",
    "ExpireMinutes": 120
  },

  "ConnectionStrings": {
    "Default": "Server=localhost;Database=XuePingDB;Trusted_Connection=True;TrustServerCertificate=True;",
    "Redis": "localhost:6379,password=<你的 Redis 密码>"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MessageBus": {
    "Provider": "RedisStream",
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "VirtualHost": "/"
  },
  "AllowedHosts": "*"
}
